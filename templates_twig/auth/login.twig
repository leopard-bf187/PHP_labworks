{% extends "layout.twig" %}

{% block title %}Вход{% endblock %}

{% block content %}
<h1>Вход в систему</h1>

{% if errors is not empty %}
    <div class="error-box">
        <p>Обнаружены ошибки:</p>
        <ul>
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<form action="index.php?page=login_store" method="POST" class="form-card">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <label for="username">Имя пользователя:</label>
    <input
        type="text"
        id="username"
        name="username"
        required
        minlength="3"
        maxlength="50"
        value="{{ old.username|default('') }}"
        placeholder="Введите логин"
    >

    <label for="password">Пароль:</label>
    <input
        type="password"
        id="password"
        name="password"
        required
        minlength="6"
        placeholder="Введите пароль"
    >

    <label for="captcha">Проверка: сколько будет {{ captcha_question }}?</label>
    <input
        type="text"
        id="captcha"
        name="captcha"
        required
        placeholder="Введите ответ"
    >

    <div class="button-group">
        <button type="submit">Войти</button>
        <a href="index.php?page=register" class="button-link">Регистрация</a>
    </div>
</form>
{% endblock %}


