{% extends "layout.twig" %}

{% block title %}{{ title|default('Регистрация') }}{% endblock %}

{% block content %}
<h1>{{ title|default('Регистрация') }}</h1>

{% if errors is not empty %}
    <div class="error-box">
        <p>Обнаружены ошибки:</p>
        <ul>
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<form action="{{ action }}" method="POST" class="form-card">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <label for="username">Имя пользователя:</label>
    <input
        type="text"
        id="username"
        name="username"
        required
        minlength="3"
        maxlength="50"
        pattern="[a-zA-Z0-9_]+"
        value="{{ old.username|default('') }}"
        placeholder="Например: leonid_user"
    >

    <label for="email">Email:</label>
    <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="120"
        value="{{ old.email|default('') }}"
        placeholder="user@example.com"
    >

    <label for="password">Пароль:</label>
    <input
        type="password"
        id="password"
        name="password"
        required
        minlength="6"
        placeholder="Минимум 6 символов"
    >

    <label for="password_confirm">Подтверждение пароля:</label>
    <input
        type="password"
        id="password_confirm"
        name="password_confirm"
        required
        minlength="6"
        placeholder="Повторите пароль"
    >

    <label for="captcha">Проверка: сколько будет {{ captcha_question }}?</label>
    <input
        type="text"
        id="captcha"
        name="captcha"
        required
        placeholder="Введите ответ"
    >

    <div class="button-group">
        <button type="submit">Сохранить</button>
        <a href="index.php?page=home" class="button-link">На главную</a>
    </div>
</form>
{% endblock %}


