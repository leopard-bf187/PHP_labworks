{% extends "layout.twig" %}

{% block title %}Результат отправки{% endblock %}

{% block content %}
<h1>Результат обработки формы</h1>

{% if result.success %}
    <div class="success-box">
        <p>Запись успешно сохранена.</p>
    </div>
{% else %}
    <div class="error-box">
        <p>Обнаружены ошибки:</p>
        <ul>
            {% for error in result.errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<div class="button-group">
    <a href="?page=form&view=twig" class="button-link">Вернуться к форме</a>
    <a href="?page=list&view=twig" class="button-link">Посмотреть записи</a>
    <a href="?page=form&view=php" class="button-link">PHP-версия</a>
</div>
{% endblock %}